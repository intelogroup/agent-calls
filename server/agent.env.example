# Copy to /opt/agent/agent.env and fill in. Never commit real values.
AGENT_SIP_USER=jett-agent
AGENT_SIP_PASS=CHANGEME
AGENT_SIP_DOMAIN=sip.linphone.org
AGENT_SIP_PORT=5060
AGENT_NAME=Jett
AGENT_RTP_PORT=10000
AGENT_PUBLIC_IP=CHANGEME   # VM's public IP (for SDP)
AGENT_WHISPER_MODEL=tiny.en
AGENT_LLM_MODEL=/opt/agent/models/llm.gguf
AGENT_TTS_ENGINE=kokoro     # kokoro | espeak
AGENT_MAX_TURNS=8
AGENT_MAX_CALL_SEC=300
AGENT_GREETING=Hey, it's Jett. What do you want to talk about?
